#!/usr/bin/env sh
set -eu

repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if ! command -v chezmoi >/dev/null 2>&1; then
  sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
fi

CHEZMOI="${CHEZMOI:-chezmoi}"

if ! command -v "$CHEZMOI" >/dev/null 2>&1 && [ -x "$HOME/.local/bin/chezmoi" ]; then
  CHEZMOI="$HOME/.local/bin/chezmoi"
fi

if [ -n "${DEVPOD:-}" ] || [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ] || [ ! -t 0 ]; then
  CHEZMOI_SOURCE_DIR="$repo_dir" "$CHEZMOI" --source "$repo_dir" --force --no-tty init
  "$CHEZMOI" --source "$repo_dir" --force --no-tty apply
else
  CHEZMOI_SOURCE_DIR="$repo_dir" "$CHEZMOI" --source "$repo_dir" init
  "$CHEZMOI" --source "$repo_dir" apply
fi
