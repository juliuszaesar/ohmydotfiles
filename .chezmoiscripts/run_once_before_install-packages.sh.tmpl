#!/usr/bin/env sh
set -eu

if command -v apt-get >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y \
    bash \
    bat \
    btop \
    ca-certificates \
    curl \
    fd-find \
    fzf \
    git \
    lsd \
    ripgrep \
    starship \
    unzip \
    zoxide \
    zsh
elif command -v brew >/dev/null 2>&1; then
  brew bundle --no-lock --file=- <<'BREWFILE'
brew "bash"
brew "bat"
brew "btop"
brew "curl"
brew "fd"
brew "fzf"
brew "git"
brew "mise"
brew "ripgrep"
brew "starship"
brew "zoxide"
brew "zsh"
BREWFILE
else
  printf '%s\n' "No supported package manager found; skipping package install."
fi
